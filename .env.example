# --- Base de datos (Supabase o Neon) ---
# URL con pooler (la que usa la app en Vercel).
#  Supabase: Project Settings > Database > Connection string > "Transaction pooler" (puerto 6543) y agrega ?pgbouncer=true
#  Neon:     Connection string con "Pooled connection" activado
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/observatorio?schema=public"
# Conexión directa (la usan las migraciones de Prisma). En local es la misma.
#  Supabase: "Direct connection" (puerto 5432) o "Session pooler"
#  Neon:     Connection string SIN pooler
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/observatorio?schema=public"

# --- Auth.js (NextAuth) ---
# Genera uno con:  openssl rand -base64 32
NEXTAUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
# En local: http://localhost:3000 — en Vercel: https://tu-proyecto.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# --- Seed ---
# Contraseña de las cuentas demo (admin, bienestar, docente, estudiante). Cámbiala en producción.
SEED_DEMO_PASSWORD="Ucc2026!"
