# --- Base de datos (Neon o Supabase) ---
# Se usan los MISMOS nombres que crea la integración Neon–Vercel, así en Vercel no hay que copiar nada.
# URL con pooler (la que usa la app). La app agrega pgbouncer=true sola si detecta un pooler.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/observatorio?schema=public"
# Conexión directa (la usan las migraciones de Prisma). En local es la misma.
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/observatorio?schema=public"

# --- Auth.js (NextAuth) ---
# Genera uno con:  openssl rand -base64 32
NEXTAUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
# En local: http://localhost:3000 — en Vercel no hace falta (usa el dominio del despliegue)
NEXTAUTH_URL="http://localhost:3000"

# --- Primer administrador (solo se crea si no existe ninguno) ---
# Sin valor por defecto: elige una contraseña de 8+ caracteres con letras y números.
SEED_ADMIN_PASSWORD=""
# Opcional (por defecto admin@ucc.edu.co)
SEED_ADMIN_EMAIL=""

# --- Agente de IA (Google Gemini) ---
# Clave gratuita en https://aistudio.google.com/apikey . Sin ella el sistema funciona, pero sin el chat del agente
# y con explicaciones calculadas sin IA.
GEMINI_API_KEY=""
# Opcional: modelo a usar (por defecto gemini-flash-latest)
GEMINI_MODEL=""
