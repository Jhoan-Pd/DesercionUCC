erDiagram
    USUARIOS ||--o{ CARGAS : "sube"
    CARGAS |o--o{ ESTUDIANTES : "trae o actualiza"
    ESTUDIANTES ||--o| EVALUACIONES : "tiene"

    USUARIOS {
        uuid id PK
        string email UK
        string nombre
        string passwordHash
        enum rol "ADMIN | BIENESTAR"
        bool activo
        int intentosFallidos
        datetime bloqueadoHasta
    }
    CARGAS {
        uuid id PK
        string archivo
        int filas
        int nuevos
        int actualizados
        json errores
        uuid usuarioId FK
        datetime creadaEn
    }
    ESTUDIANTES {
        uuid id PK
        string codigo UK
        string nombre
        string programa
        int semestre
        float promedio "opcional"
        int materiasPerdidas "opcional"
        float asistencia "opcional"
        int estrato "opcional"
        bool trabaja "opcional"
        bool apoyoFinanciero "opcional"
        bool moraMatricula "opcional"
        int puntajeSaber11 "opcional"
        int edad "opcional"
        enum estado "ACTIVO | RETIRADO | GRADUADO"
        string periodo
        uuid cargaId FK
    }
    EVALUACIONES {
        uuid id PK
        uuid estudianteId FK
        int puntaje "0-100"
        enum nivel "BAJO | MEDIO | ALTO"
        string metodo "FACTORES | MODELO"
        string modeloVersion
        json factores
        string_lista faltantes
        text explicacion "agente IA"
        string modeloIa
    }
    MODELOS_RIESGO {
        uuid id PK
        string version UK
        json definicion
        json metricas
        bool activo
    }
