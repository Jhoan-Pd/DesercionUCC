// =====================================================================
// Observatorio de Deserción UCC — Esquema de base de datos (PostgreSQL)
// =====================================================================
// Versión simplificada (v0.4):
//  - Solo datos REALES: los estudiantes los carga el administrador desde un archivo de la
//    universidad. No hay datos simulados; la base arranca vacía (solo la cuenta del administrador).
//  - Dos roles: ADMIN (carga datos y gestiona cuentas) y BIENESTAR (consulta el riesgo y usa el agente).
//  - El riesgo se guarda por estudiante (Evaluacion) junto con los factores que lo explican y,
//    cuando se pide, la explicación redactada por el agente de IA.
//  - Las cifras oficiales de datos.gov.co no van en la base: se leen de data/datos-abiertos/ucc.json.
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Rol {
  ADMIN
  BIENESTAR
}

enum EstadoEstudiante {
  ACTIVO
  RETIRADO
  GRADUADO
}

enum NivelRiesgo {
  BAJO
  MEDIO
  ALTO
}

model Usuario {
  id               String    @id @default(uuid())
  email            String    @unique
  nombre           String
  passwordHash     String
  rol              Rol
  activo           Boolean   @default(true)
  /// Protección contra fuerza bruta (lib/seguridad/bloqueo.ts)
  intentosFallidos Int       @default(0)
  bloqueadoHasta   DateTime?
  ultimoAcceso     DateTime?
  creadoEn         DateTime  @default(now())
  actualizadoEn    DateTime  @updatedAt
  cargas           Carga[]

  @@map("usuarios")
}

/// Cada archivo de estudiantes que sube el administrador (trazabilidad de la información)
model Carga {
  id           String       @id @default(uuid())
  archivo      String
  filas        Int
  nuevos       Int
  actualizados Int
  /// Filas rechazadas: [{ fila, mensaje }]
  errores      Json
  usuarioId    String
  usuario      Usuario      @relation(fields: [usuarioId], references: [id])
  creadaEn     DateTime     @default(now())
  estudiantes  Estudiante[]

  @@index([creadaEn])
  @@map("cargas")
}

/// Estudiante tal como viene en el archivo de la universidad. Los campos opcionales que falten
/// simplemente no se usan en el cálculo del riesgo (nunca se inventan).
model Estudiante {
  id               String           @id @default(uuid())
  codigo           String           @unique
  nombre           String
  programa         String
  semestre         Int
  /// Promedio acumulado (escala 0-5)
  promedio         Float?
  /// Materias perdidas en el último periodo
  materiasPerdidas Int?
  /// Porcentaje de asistencia (0-100)
  asistencia       Float?
  estrato          Int?
  trabaja          Boolean?
  /// Tiene beca, crédito o subsidio para la matrícula
  apoyoFinanciero  Boolean?
  /// Tiene pagos de matrícula pendientes
  moraMatricula    Boolean?
  /// Puntaje global Saber 11 (0-500)
  puntajeSaber11   Int?
  edad             Int?
  /// ACTIVO, o el resultado conocido (RETIRADO / GRADUADO) que sirve para entrenar el modelo
  estado           EstadoEstudiante @default(ACTIVO)
  /// Periodo al que corresponden los datos (p. ej. 2026-2)
  periodo          String?
  cargaId          String?
  carga            Carga?           @relation(fields: [cargaId], references: [id], onDelete: SetNull)
  evaluacion       Evaluacion?
  creadoEn         DateTime         @default(now())
  actualizadoEn    DateTime         @updatedAt

  @@index([programa])
  @@index([estado])
  @@map("estudiantes")
}

/// Riesgo calculado para un estudiante y su explicación
model Evaluacion {
  id            String      @id @default(uuid())
  estudianteId  String      @unique
  estudiante    Estudiante  @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  /// 0-100
  puntaje       Int
  nivel         NivelRiesgo
  /// "FACTORES" (puntaje por factores documentados) o "MODELO" (regresión logística entrenada con datos de la UCC)
  metodo        String
  /// Versión del modelo cuando metodo = MODELO
  modeloVersion String?
  /// Factores que suman al riesgo: [{ clave, etiqueta, puntos, detalle }]
  factores      Json
  /// Datos que no venían en el archivo y no se pudieron evaluar
  faltantes     String[]
  calculadoEn   DateTime    @default(now())
  /// Explicación redactada por el agente de IA (se genera a pedido y se guarda)
  explicacion   String?
  explicadaEn   DateTime?
  modeloIa      String?

  @@index([nivel])
  @@map("evaluaciones")
}

/// Versiones del modelo estadístico entrenado con estudiantes reales que ya tienen resultado
model ModeloRiesgo {
  id         String   @id @default(uuid())
  version    String   @unique
  /// Características, medias, desviaciones, coeficientes, intercepto y umbrales
  definicion Json
  /// AUC, Brier, tamaño de muestra, etc. (evaluado con estudiantes que no se usaron para entrenar)
  metricas   Json
  activo     Boolean  @default(false)
  creadoEn   DateTime @default(now())

  @@index([activo])
  @@map("modelos_riesgo")
}
